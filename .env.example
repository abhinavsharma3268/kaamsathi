# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Optional Grok Voice (xAI) for realtime speech-to-speech on Home → Voice
# https://console.x.ai/ — never expose this key in the browser
# XAI_API_KEY=

# Optional cloud sync for earnings (otherwise local-first + JSON export/import)
# KAAMSAATHI_SYNC_URL=https://example.com/kaamsaathi-sync
# KAAMSAATHI_SYNC_TOKEN=
